# =========================================================
# Kalendiario — environment template (copy to .env and fill in)
# NEVER commit real secrets. This file has only placeholders.
# =========================================================

# --- Database ---
DATABASE_URL="mysql://dayly:CHANGE_ME@localhost:3306/dayly"

# --- Server ---
# Port the API listens on
PORT=4000
# Comma-separated origins allowed to call the API (browser CORS). In dev,
# the Vite dev server runs on http://localhost:5173.
CLIENT_ORIGIN="http://localhost:5173"
# Public URL (used for links in emails and for session cookie domain).
PUBLIC_URL="http://localhost:4000"
# Environment: development | test | production
NODE_ENV="development"

# --- Security ---
# 32+ random bytes, base64. Used to sign session cookies and encrypt 2FA
# secrets. Generate with: openssl rand -base64 48
APP_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
# Comma-separated header names trusted for the real client IP behind a proxy
# (set to e.g. "1" behind Cloudflare/nginx). Required in production.
TRUST_PROXY=""
# How long session cookies live (ms). Default 30 days.
SESSION_TTL_MS="2592000000"
# Public self-service signup. Defaults to false in production, true otherwise.
ALLOW_PUBLIC_REGISTRATION="false"
# First-boot only: if the DB has zero users, create this admin. Then unset
# ADMIN_PASSWORD from the running process if you rotate it.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Bootstrap inicial de integraciones ---
# Estos valores se importan una sola vez a la base de datos. Después se gestionan
# en Panel admin y cambiar el .env no reactiva ni sobrescribe una configuración.

# SMTP transaccional (verificación / recuperación). Opcional en desarrollo.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kalendiario <no-reply@example.com>"

# Bot heredado de Telegram. Solo para la migración explícita a un administrador;
# los usuarios nuevos conectan su propio bot desde Ajustes.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# --- Mensajes empresariales (desactivado por defecto) ---
# Interruptor global inicial. Cada usuario aporta después su propio bot.
MESSAGING_TELEGRAM_BUSINESS_ENABLED="false"

# WhatsApp oficial: crea una configuración de Embedded Signup preparada para
# coexistencia en Meta. La versión Graph es obligatoria cuando se habilita;
# se mantiene en configuración para revisarla antes de cada despliegue.
MESSAGING_WHATSAPP_ENABLED="false"
WHATSAPP_APP_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_GRAPH_VERSION=""

# --- Web Push (optional). Generate: node scripts/gen-vapid.mjs ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Seed ---
# When true, `npm run db:seed` creates a demo user + sample data.
# Never enable this on a public server.
SEED_DEMO="false"

# --- Spotify ---
# Client ID público de la app PKCE, importado una vez. Redirect URIs:
#   {PUBLIC_URL}/spotify/callback
#   http://127.0.0.1:5173/spotify/callback
# SPOTIFY_CLIENT_ID=""

# --- Gmail (OAuth, «Conectar con Google») ---
# Optional bootstrap. If both are set, users can connect Gmail after import.
# Create an OAuth client (Web application) in Google Cloud, enable the Gmail API,
# and add these redirect URIs:
#   {PUBLIC_URL}/api/inbox/mailboxes/google/callback
#   http://localhost:5173/api/inbox/mailboxes/google/callback
# Scope: https://mail.google.com/
# Until Google verifies the app, add your Gmail as a test user in the consent screen.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Football fixtures (optional). https://www.football-data.org/ ---
# Optional server-wide fallback. Users can also paste their own key in Ajustes → Mascota.
FOOTBALL_DATA_API_KEY=""

# --- Attachments ---
# Directory for task/note/reminder files. Defaults to ./uploads
# UPLOAD_DIR="uploads"

# Native installers (kalendiario-windows.exe, kalendiario.apk). Defaults to ./downloads
# DOWNLOADS_DIR="downloads"
