{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@attachment-policy": ["../server/src/lib/attachment-policy.ts"],
      "@brand": ["../server/src/lib/brand.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../server/src/lib/attachment-policy.ts", "../server/src/lib/brand.ts"],
  "exclude": ["vite.config.ts", "node_modules", "dist"]
}